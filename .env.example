# Copy this file to .env and fill in what you have. Everything is optional —
# the pipeline runs with zero keys using free local fallbacks (macOS `say`
# for voice, a generated placeholder background).

# --- Script writing (optional) ---
# If set, narration beats get punched up by Claude for punchier phrasing.
ANTHROPIC_API_KEY=

# --- Text-to-speech ---
# "say" (default, free, local) or "elevenlabs" (for a custom/cloned voice).
TTS_PROVIDER=say

# Only used when TTS_PROVIDER=say. Pick any voice from `say -v ?`.
SAY_VOICE=Samantha

# Only used when TTS_PROVIDER=elevenlabs. You add/find the voice yourself
# in your own ElevenLabs Voice Library (this script won't source one for you).
ELEVENLABS_API_KEY=
VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
