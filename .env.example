# Copy this file to .env and fill in what you have. Everything is optional —
# the pipeline runs with zero keys using free local fallbacks (Kokoro
# neural voice, rule-based story picks and hooks).

# --- Script writing (optional) ---
# If set, Claude (Sonnet 5.5) picks the day's most interesting stories and writes
# each 40-60s video: hook, spoken beats, on-screen cards, outro. Without it, a
# rule-based writer groups TLDR's top stories into videos of the same length.
ANTHROPIC_API_KEY=
# How hard Claude reasons when writing: medium (default) is the tested sweet spot.
WRITER_EFFORT=medium

# --- Story selection (optional) ---
# If set, Jev (TypeSafe AI's decision model) classifies and scores each
# candidate story (in scope? how newsworthy?) before Claude ever sees them,
# so Claude only writes from the pre-filtered/ranked set. Without it, Claude
# sees the full candidate list and does the selection itself.
TYPESAFE_API_KEY=

# --- Text-to-speech ---
# "kokoro" (default: free, local, natural-sounding), "say" (macOS built-in,
# robotic), "elevenlabs" (cloud, cloned voice) or "voicebox" (local, cloned
# voice via the Voicebox app — voicebox.sh, must be running).
TTS_PROVIDER=kokoro

# Only used when TTS_PROVIDER=kokoro. List voices: npx hyperframes tts --list
# e.g. af_heart, af_nova, am_michael, am_adam, bf_emma, bm_george
KOKORO_VOICE=af_heart
KOKORO_SPEED=1.1

# Only used when TTS_PROVIDER=voicebox. Voicebox's API listens on
# localhost:17493; the app must be running. VOICEBOX_PROFILE_ID is a voice
# profile you've already cloned there from your own reference audio — this
# script doesn't source or clone a reference voice for you.
VOICEBOX_PROFILE_ID=
VOICEBOX_ENGINE=qwen
VOICEBOX_MODEL_SIZE=0.6B
# Natural-language delivery instruction (Qwen3-TTS supports this directly).
# Leave blank for natural delivery — pushing for "more emphasis/energy" was
# found to distort sibilants into a lisp on this voice. Try cautiously.
VOICEBOX_INSTRUCT=

# "none" keeps the voice natural; "cartoon" pitches it up into a squeaky cartoon register (any
# provider). CARTOON_PITCH: 1.3 subtle .. 1.6 squeaky.
VOICE_EFFECT=none
CARTOON_PITCH=1.45

# Only used when TTS_PROVIDER=say. Pick any voice from `say -v ?`.
SAY_VOICE=Samantha

# Only used when TTS_PROVIDER=elevenlabs. You add/find the voice yourself
# in your own ElevenLabs Voice Library (this script won't source one for you).
ELEVENLABS_API_KEY=
VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Video look (optional) ---
# "explainer" (default) is a clean animated explainer with no avatar and no
# footage, built from a scene plan Claude writes (pictograms, charts,
# diagrams, device wireframes). "avatar" is the original look: narrator
# cutout, gameplay footage, highlighted cards. See README "Video styles".
VIDEO_STYLE=explainer
# Where the stories come from. "tldr" (default, the only source so far)
# scrapes the TLDR newsletters; see newsletter_video/sources/.
SOURCE=tldr
# Explainer style only: "light" (default, warm paper) or "dark".
VIDEO_THEME=light
# Avatar style only. "gameplay" (default) puts a clip from assets/background/
# behind the video; "none" drops it for the plain graph-paper background.
BACKGROUND_STYLE=gameplay
# The narrator: a folder name under assets/characters/ (avatar + cloned voice +
# writing persona), managed with `python -m newsletter_video.characters`.
# Leave blank for the original single avatar in assets/character/ and the
# voice in VOICEBOX_PROFILE_ID.
CHARACTER=

# --- YouTube upload (optional) ---
# 1 = upload each day's videos after rendering (needs the one-time --auth setup).
YOUTUBE_UPLOAD=0
# private (default) | unlisted | public. Until Google audits your API project,
# YouTube forces API uploads to private regardless.
YOUTUBE_PRIVACY=private
# Optional local times to auto-publish the day's videos, e.g. 12:00,16:00,20:00
# (videos upload as private and YouTube flips them public at those times).
YOUTUBE_SCHEDULE=

# How many videos to make each day. "~6/day" is a commonly cited estimate
# (10,000-unit default API quota / ~1,600 units per videos.insert call), but
# it's folklore, not an enforced limit in this code: 16 uploads succeeded in
# one day during testing with no quota or uploadLimitExceeded errors. If you
# need the real number, check Google Cloud Console → APIs & Services →
# YouTube Data API v3 → Quotas for this project's actual unit usage.
VIDEOS_PER_DAY=3
